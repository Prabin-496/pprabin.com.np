# Copy to backend/.env on EC2 (never commit real values)
GEMINI_API_KEY=your_gemini_api_key_here

PORT=4100
NODE_ENV=development

# Gemini model (audio + text)
GEMINI_MODEL=gemini-2.0-flash

# Data directory (SQLite + audio files) — never inside portfolio src/
DATA_DIR=../voice-ai-data

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5175,https://www.pprabin.com.np,https://pprabin.com.np

# Rate limit (requests per 15 min per IP)
RATE_LIMIT_MAX=60

# Max audio chunk upload (MB) — nginx must match (50M)
MAX_UPLOAD_MB=50
