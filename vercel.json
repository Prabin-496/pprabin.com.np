{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/voice/(.*)$",
      "dest": "/api/voice?path=$1"
    },
    {
      "src": "/api/recordings/(.*)$",
      "dest": "/api/voice?path=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/voice-ai",
      "dest": "/voice-ai/index.html"
    },
    {
      "src": "/voice-ai/",
      "dest": "/voice-ai/index.html"
    },
    {
      "src": "/hunt",
      "dest": "/hunt/index.html"
    },
    {
      "src": "/hunt/",
      "dest": "/hunt/index.html"
    },
    {
      "src": "/flashcards",
      "dest": "/flashcards/index.html"
    },
    {
      "src": "/flashcards/",
      "dest": "/flashcards/index.html"
    },
    {
      "src": "/transcriber.html",
      "dest": "/transcriber.html"
    },
    {
      "src": "/[^.]+",
      "dest": "/"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/hunt?a=cron",
      "schedule": "0 21 * * *"
    }
  ]
}
