{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:flashcards && npm run build:voice-ai && vite build",
    "build:flashcards": "npm install --prefix flashcards/frontend && npm run build --prefix flashcards/frontend",
    "dev:flashcards": "npm run dev --prefix flashcards/frontend",
    "dev:flashcards-api": "npm run dev --prefix flashcards/backend",
    "build:voice-ai": "npm install --prefix apps/voice-transcriber/frontend && npm run build --prefix apps/voice-transcriber/frontend",
    "dev:voice-ai": "npm run dev --prefix apps/voice-transcriber/frontend",
    "dev:voice-ai-api": "npm run --prefix apps/voice-transcriber/backend dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@google/generative-ai": "^0.24.0",
    "@heroicons/react": "^2.0.0",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.526.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.0",
    "vercel": "^25.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  }
}
