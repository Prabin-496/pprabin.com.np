# Server
PORT=4000
NODE_ENV=production

# AWS (use IAM role on EC2 instead of keys when possible)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB — your existing table
DYNAMODB_TABLE_NAME=Japanese_Flashcard

# Comma-separated origins allowed to call this API (your portfolio domain)
CORS_ORIGINS=https://www.pprabin.com.np,https://pprabin.com.np,http://localhost:5174,http://localhost:5176
